# Kamano backend configuration (copy to .env for local dev)

ENVIRONMENT=development
DEBUG=true

# --- Data residency (POPIA sovereignty) ---
# The app refuses to start if enforce_data_residency=true and data_region is
# not an African region. Supabase Cloud has NO African region, so production
# uses AWS RDS + S3 in af-south-1, not Supabase Cloud.
DATA_REGION=af-south-1
ENFORCE_DATA_RESIDENCY=true

# --- Database (AWS RDS PostgreSQL in af-south-1 for production) ---
DATABASE_URL=postgresql+asyncpg://kamano:kamano@localhost:5432/kamano
# USE_DATABASE=false -> always in-memory (demo). true -> PostgreSQL if reachable,
# otherwise automatic fallback to in-memory so the app still boots.
USE_DATABASE=false

# --- Ed25519 signing keys (production: load from secrets manager / KMS) ---
ED25519_PRIVATE_KEY_PATH=./keys/ed25519_private.pem
ED25519_PUBLIC_KEY_PATH=./keys/ed25519_public.pem
ISSUER_DID=did:web:kamano.co.za

# --- Auth ---
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- POPIA / retention ---
RAW_DOCUMENT_RETENTION_DAYS=30
AUDIT_RECORD_RETENTION_DAYS=1825
POPIA_AUDIT_ENABLED=true

# --- Source-of-truth integrations (keep OFF until real API access exists) ---
# While all are false, verifications can only reach assurance Tier C.
ENABLE_SARS_INTEGRATION=false
ENABLE_CIPC_INTEGRATION=false
ENABLE_HOME_AFFAIRS_INTEGRATION=false
